# Database (Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/ut_parking?schema=public"

# Stripe (test keys to start — request real UT merchant keys before going live)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# DEMO ONLY — set to "true" to click through the purchase flow to confirmation
# without real Stripe keys/network access (see /api/stripe/mock-pay). Leave unset
# in any environment with real Stripe keys.
NEXT_PUBLIC_MOCK_PAYMENTS="true"

# Staff SSO (placeholder until UT IT provides Shibboleth/SAML/OAuth connection details)
# Do not build real auth against these until UT IT gives you real values.
STAFF_SSO_CLIENT_ID=""
STAFF_SSO_CLIENT_SECRET=""
STAFF_SSO_ISSUER_URL=""

# Fallback simple staff login, ONLY for local dev/testing until SSO is wired up
STAFF_DEV_USERNAME="longhorn"
STAFF_DEV_PASSWORD="123"
